        "definition": "SELECT DISTINCT\n  TRIM(room.assetstatus_display) AS __text,\n  TRIM(room.assetstatus_display) AS __value\nFROM eam_positions room\nWHERE room.eqclass = 'AVR'\n  AND room.category IN ('AV-VCR','AV-VIS','AV-MRO')\n  AND room.assetstatus_display IS NOT NULL\n  AND room.assetstatus_display <> ''\nORDER BY 1;\n",
