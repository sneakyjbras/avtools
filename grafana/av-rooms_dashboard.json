        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ed690575-af6b-41b8-a72d-81f47592f349"
          },
          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "-- PG_DEVICES (room \u2194 device equipmentno) with stable room_sort_rank\nWITH RECURSIVE\ndevice_positions AS (\n  SELECT DISTINCT d.position\n  FROM eam_devices d\n  WHERE d.position IS NOT NULL\n),\nclimb_up AS (\n  SELECT\n    dp.position          AS start_pos,\n    p.equipmentno        AS cur_pos,\n    p.parentasset        AS parent_pos,\n    0                    AS depth,\n    ARRAY[p.equipmentno] AS visited\n  FROM device_positions dp\n  JOIN eam_positions p ON p.equipmentno = dp.position\n  UNION ALL\n  SELECT\n    c.start_pos,\n    p.equipmentno,\n    p.parentasset,\n    c.depth + 1,\n    c.visited || p.equipmentno\n  FROM climb_up c\n  JOIN eam_positions p ON p.equipmentno = c.parent_pos\n  WHERE c.parent_pos IS NOT NULL\n    AND c.depth < 100\n    AND p.equipmentno <> ALL (c.visited)\n),\npos_to_room AS (\n  SELECT DISTINCT ON (c.start_pos)\n    c.start_pos,\n    c.cur_pos AS room_no\n  FROM climb_up c\n  JOIN eam_positions rp ON rp.equipmentno = c.cur_pos\n  WHERE rp.eqclass = 'AVR'\n    AND rp.category IN ('AV-VCR','AV-VIS','AV-MRO')\n  ORDER BY c.start_pos, c.depth DESC, c.cur_pos\n),\nrooms AS (\n  SELECT DISTINCT room.equipmentno AS ConferenceRoomNo\n  FROM pos_to_room pr\n  JOIN eam_positions room ON room.equipmentno = pr.room_no\n  WHERE\n    (\n      '${status:raw}' = '__all'\n      OR ('${status:raw}' = '__none__' AND room.assetstatus_display IS NULL)\n      OR room.assetstatus_display ~ ('^(' || '${status:regex}' || ')$')\n    )\n),\n\n-- build same natural-sort pieces as Query A\nroom_keys AS (\n  SELECT\n    r.ConferenceRoomNo\n  , CONCAT(\n      split_part(split_part(r.ConferenceRoomNo,'-',2),'.',1), '/',\n      split_part(split_part(r.ConferenceRoomNo,'-',2),'.',2), '-',\n      split_part(split_part(r.ConferenceRoomNo,'-',2),'.',3)\n    ) AS ConferenceRoomNoFmt\n  , split_part(split_part(r.ConferenceRoomNo,'-',2),'.',1) AS part1_txt\n  , split_part(split_part(r.ConferenceRoomNo,'-',2),'.',2) AS part2_txt\n  , split_part(split_part(r.ConferenceRoomNo,'-',2),'.',3) AS part3_txt\n  FROM rooms r\n),\nranked AS (\n  SELECT\n    ConferenceRoomNo\n  , ConferenceRoomNoFmt\n  , NULLIF(regexp_replace(part1_txt, '\\D.*$', ''), '')::int AS part1_num\n  , regexp_replace(part1_txt, '^\\d+', '')                    AS part1_suf\n  , NULLIF(regexp_replace(part2_txt, '\\D.*$', ''), '')::int AS part2_num\n  , regexp_replace(part2_txt, '^\\d+', '')                    AS part2_suf\n  , NULLIF(regexp_replace(part3_txt, '\\D.*$', ''), '')::int AS part3_num\n  , regexp_replace(part3_txt, '^\\d+', '')                    AS part3_suf\n  FROM room_keys\n),\n-- produce a single numeric rank to carry through Grafana grouping\nroom_order AS (\n  SELECT\n    ConferenceRoomNo\n  , ConferenceRoomNoFmt\n  , DENSE_RANK() OVER (\n      ORDER BY\n        part1_num NULLS LAST, part1_suf,\n        part2_num NULLS LAST, part2_suf,\n        part3_num NULLS LAST, part3_suf,\n        ConferenceRoomNo\n    ) AS room_sort_rank\n  FROM ranked\n),\n\ndown AS (\n  SELECT\n    r.ConferenceRoomNo\n  , p.equipmentno\n  , 1                    AS depth\n  , ARRAY[p.equipmentno] AS visited\n  FROM rooms r\n  JOIN eam_positions p ON p.parentasset = r.ConferenceRoomNo\n  UNION ALL\n  SELECT\n    d.ConferenceRoomNo\n  , p.equipmentno\n  , d.depth + 1\n  , d.visited || p.equipmentno\n  FROM down d\n  JOIN eam_positions p ON p.parentasset = d.equipmentno\n  WHERE d.depth < 100\n    AND p.equipmentno <> ALL (d.visited)\n),\nleafs AS (\n  SELECT d.ConferenceRoomNo, d.equipmentno AS leaf_position\n  FROM down d\n  LEFT JOIN eam_positions ch ON ch.parentasset = d.equipmentno\n  WHERE ch.equipmentno IS NULL\n)\nSELECT DISTINCT\n  ro.ConferenceRoomNo\n, ro.ConferenceRoomNoFmt     -- optional, for display\n, ro.room_sort_rank          -- **carry this into Grafana**\n, dev.equipmentno\nFROM leafs l\nJOIN room_order     ro  ON ro.ConferenceRoomNo = l.ConferenceRoomNo\nJOIN eam_devices    dev ON dev.position        = l.leaf_position\nJOIN eam_positions  pos ON pos.equipmentno     = l.leaf_position\n-- no device/position status filter anymore\nORDER BY ro.room_sort_rank, ro.ConferenceRoomNo, dev.equipmentno;\n",
          "refId": "B",
