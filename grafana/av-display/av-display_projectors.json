      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ed690575-af6b-41b8-a72d-81f47592f349"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH FilteredDevices AS (\n  SELECT\n    d.equipmentno         AS DeviceNo,\n    d.position            AS PositionNo,\n    d.equipmentdesc       AS DeviceDesc,\n    d.manufacturer        AS Manufacturer,\n    d.commissiondate      AS CommissionDate,\n    d.serialnumber,\n    d.assetstatus_display AS LeafStatus\n  FROM eam_devices d\n  WHERE d.eqclass  = 'AVD'\n    AND d.category = 'AV-PRO'\n    AND d.assetstatus_display = 'Installed'   -- << only Installed\n)\nSELECT\n  fd.DeviceDesc                              AS Name,\n  fd.Manufacturer AS Manufacturer,\n\n  -- deepest *parent* position (raw equipmentno; NULL if no parent)\n  deepest.positionno                         AS DeepestParentEquipmentNo,\n\n  -- formatted as X/Y-Z when it matches CCA-X.Y.Z (case-insensitive, ignores any extra dotted tail)\n  REGEXP_REPLACE(\n    deepest.positionno,\n    '(?i)^CCA-([^.]+)\\.([^.]+)\\.([^.]+)(?:\\..*)?$',\n    '\\1/\\2-\\3'\n  )                                           AS DeepestParentEquipmentNo_fmt,\n\n  fd.LeafStatus                               AS LeafStatus,\n  fd.CommissionDate                           AS CommissionDate,\n  fd.DeviceNo                                 AS EquipmentNo,\n  CASE WHEN ld.equipmentno IS NOT NULL THEN 1 END AS Resources\nFROM FilteredDevices fd\nLEFT JOIN landb_devices ld\n  ON fd.DeviceNo     = ld.equipmentno\n AND fd.serialnumber = ld.serialnumber\n\n-- climb from the parent of the device's position to the root; pick the farthest (max depth)\nLEFT JOIN LATERAL (\n  WITH RECURSIVE climb AS (\n    -- anchor: immediate parent of the device's position\n    SELECT p.equipmentno AS positionno,\n           p.parentasset AS parent,\n           1             AS depth,\n           ARRAY[p.equipmentno] AS visited\n    FROM eam_positions p\n    WHERE p.equipmentno = (\n      SELECT parentasset\n      FROM eam_positions\n      WHERE equipmentno = fd.PositionNo\n    )\n\n    UNION ALL\n\n    SELECT p.equipmentno,\n           p.parentasset,\n           climb.depth + 1,\n           climb.visited || p.equipmentno\n    FROM climb\n    JOIN eam_positions p ON p.equipmentno = climb.parent\n    WHERE climb.parent IS NOT NULL\n      AND climb.depth < 100\n      AND NOT p.equipmentno = ANY (climb.visited) -- cycle guard\n  )\n  SELECT positionno\n  FROM climb\n  ORDER BY depth DESC\n  LIMIT 1\n) AS deepest(positionno) ON TRUE\n\nORDER BY Name;\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
