{
  "title": "avtools-pdu-outlets",
  "folderUid": "beuar1of5bo5cf",
  "interval": 300,
  "rules": [
    {
      "id": 0,
      "uid": "avoutletovercurrent",
      "orgID": 12,
      "folderUID": "beuar1of5bo5cf",
      "ruleGroup": "avtools-pdu-outlets",
      "title": "AV Tools: PDU Outlet Overcurrent (template)",
      "condition": "Active",
      "data": [
        {
          "refId": "#Outlet I",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "afcql1n10tnggc",
          "model": {
            "datasource": {
              "type": "prometheus",
              "uid": "afcql1n10tnggc"
            },
            "editorMode": "code",
            "expr": "avtools_pdu_query_outlet_current_amps{submitter_environment=\"prod\"} > 12",
            "instant": true,
            "range": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "#Outlet I"
          }
        },
        {
          "refId": "Active",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "#Outlet I",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "Active",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "300s",
      "annotations": {
        "__dashboardUid__": "av_devices_details",
        "__panelId__": "200",
        "description": "- TEMPLATE (paused by default): a single outlet drawing > 12 A (per device + outlet)\n  Per-outlet alerting spans thousands of outlets fleet-wide and is noise-prone; this rule ships PAUSED. Set a facility-appropriate current threshold (per outlet rating) and unpause, or scope it to specific critical outlets, before enabling.",
        "summary": "PDU {{ $labels.equipmentno }} outlet {{ $labels.outlet }} overcurrent"
      },
      "labels": {
        "av_alert_type": "operational",
        "severity": "warning",
        "av_alert_family": "operational"
      },
      "isPaused": true,
      "notification_settings": {
        "receiver": "AV Tools",
        "group_by": [
          "alertname",
          "grafana_folder"
        ],
        "group_wait": "1m",
        "group_interval": "1h",
        "repeat_interval": "6h"
      },
      "record": null
    }
  ]
}
