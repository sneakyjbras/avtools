{
  "title": "avtools-pdu-power-quality",
  "folderUid": "beuar1of5bo5cf",
  "interval": 300,
  "rules": [
    {
      "id": 0,
      "uid": "avpdupflow",
      "orgID": 12,
      "folderUID": "beuar1of5bo5cf",
      "ruleGroup": "avtools-pdu-power-quality",
      "title": "AV Tools: PDU Low Power Factor",
      "condition": "Active",
      "data": [
        {
          "refId": "#PDU PF Low",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "afcql1n10tnggc",
          "model": {
            "datasource": {
              "type": "prometheus",
              "uid": "afcql1n10tnggc"
            },
            "editorMode": "code",
            "expr": "(max by (equipmentno) (last_over_time(avtools_pdu_query_power_factor{submitter_environment=\"prod\"}[30d])) < 0.8) and on (equipmentno) (max by (equipmentno) (last_over_time(avtools_pdu_query_line_current_amps{submitter_environment=\"prod\"}[30d])) > 1)",
            "instant": true,
            "range": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "#PDU PF Low"
          }
        },
        {
          "refId": "Active",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "#PDU PF Low",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "Active",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "300s",
      "annotations": {
        "__dashboardUid__": "av_devices_details",
        "__panelId__": "162",
        "description": "- PDU power factor below 0.8 under load (per-device)\n  Fires when avtools_pdu_query_power_factor < 0.8 while the PDU is drawing >1 A (the load gate avoids flagging idle or lightly-loaded units, where low PF is normal).\n  A persistently low PF means real load is drawing excess apparent power (wasted capacity) - check the connected equipment / power supplies on the affected PDU.",
        "summary": "PDU {{ $labels.equipmentno }} power factor is below 0.8 under load"
      },
      "labels": {
        "av_alert_type": "operational",
        "severity": "warning",
        "av_alert_family": "operational"
      },
      "isPaused": false,
      "notification_settings": {
        "receiver": "AV Tools",
        "group_by": [
          "alertname",
          "grafana_folder"
        ],
        "group_wait": "1m",
        "group_interval": "1h",
        "repeat_interval": "6h"
      },
      "record": null
    },
    {
      "id": 0,
      "uid": "avpdupqwarn",
      "orgID": 12,
      "folderUID": "beuar1of5bo5cf",
      "ruleGroup": "avtools-pdu-power-quality",
