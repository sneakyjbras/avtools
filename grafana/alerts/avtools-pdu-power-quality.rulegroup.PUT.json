            "instant": true,
            "range": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "#PDU PQ Warn"
          }
        },
        {
          "refId": "Active",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "#PDU PQ Warn",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "Active",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "300s",
      "annotations": {
        "__dashboardUid__": "av_devices_details",
        "__panelId__": "170",
        "description": "- PDU reports a power-quality WARNING on its own configured thresholds (per-device)\n  Fires when avtools_pdu_query_pq_severity == 1 (a lowWarning/highWarning on active power, power factor, out-of-balance, or line current/load).\n  The specific dimension + state are on the *_status_info panels/metrics for the equipment.",
        "summary": "PDU {{ $labels.equipmentno }} reports a power-quality warning (device threshold)"
      },
      "labels": {
        "av_alert_type": "operational",
