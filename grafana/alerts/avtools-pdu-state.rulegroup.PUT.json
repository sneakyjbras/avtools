            },
            "expression": "#PDU Util Crit",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "Active",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "300s",
      "annotations": {
        "__dashboardUid__": "av_devices_details",
        "__panelId__": "134",
        "description": "- PDU line current >=90% of capacity (per-device)\n  Fires once per PDU whose latest line-current utilisation is at or above 90% of breaker capacity.\n  Action: shed load on the affected PDU; sustained operation near capacity risks a breaker trip.",
        "summary": "PDU {{ $labels.equipmentno }} line current is >=90% of capacity"
      },
      "labels": {
        "av_alert_type": "operational",
        "severity": "critical",
        "av_alert_family": "operational"
      },
      "isPaused": false,
      "notification_settings": {
        "receiver": "AV Tools",
        "group_by": [
          "alertname",
          "grafana_folder"
        ],
        "group_wait": "1m",
        "group_interval": "168h",
        "repeat_interval": "168h"
      },
      "record": null
    }
  ]
}
