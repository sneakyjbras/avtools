{
  "title": "avtools-pdu-state",
  "folderUid": "beuar1of5bo5cf",
  "interval": 300,
  "rules": [
    {
      "id": 0,
      "uid": "avpduunhealthy",
      "orgID": 12,
      "folderUID": "beuar1of5bo5cf",
      "ruleGroup": "avtools-pdu-state",
      "title": "AV Tools: PDU Input Feed Unhealthy",
      "condition": "Active",
      "data": [
        {
          "refId": "#PDU Unhealthy",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "afcql1n10tnggc",
          "model": {
            "datasource": {
              "type": "prometheus",
              "uid": "afcql1n10tnggc"
            },
            "editorMode": "code",
            "expr": "(max by (equipmentno) (last_over_time(avtools_pdu_query_healthy{submitter_environment=\"prod\"}[30d])) == 0) + 1",
            "instant": true,
            "range": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "#PDU Unhealthy"
          }
        },
        {
          "refId": "Active",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "#PDU Unhealthy",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "Active",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "300s",
      "annotations": {
        "__dashboardUid__": "av_devices_details",
        "__panelId__": "131",
        "description": "- PDU input feed not nominal (per-device)\n  Fires once per PDU whose latest input-feed health is not nominal (avtools_pdu_query_healthy == 0); covers both Sentry3 and Sentry4 units.\n  The specific fault is published as a label on avtools_pdu_query_status_info (resolved from the device MIB), e.g. breakerTripped, fuseBlown, overLimit, highAlarm, noComm (Sentry4) or off, offError, offFuse, noComm (Sentry3).\n  Action: check the named fault on the affected equipment's input feed / breaker.",
        "summary": "PDU {{ $labels.equipmentno }} input feed is not nominal",
        "__pdu_status_hint__": "see avtools_pdu_query_status_info{equipmentno=...}"
      },
      "labels": {
        "av_alert_type": "operational",
        "severity": "critical",
        "av_alert_family": "operational"
      },
      "isPaused": false,
      "notification_settings": {
        "receiver": "AV Tools",
        "group_by": [
          "alertname",
          "grafana_folder"
        ],
        "group_wait": "1m",
        "group_interval": "168h",
        "repeat_interval": "168h"
      },
      "record": null
    },
    {
      "id": 0,
      "uid": "avpduutilwarn",
      "orgID": 12,
      "folderUID": "beuar1of5bo5cf",
      "ruleGroup": "avtools-pdu-state",
      "title": "AV Tools: PDU Line Current High (Warning)",
      "condition": "Active",
      "data": [
        {
          "refId": "#PDU Util Warn",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "afcql1n10tnggc",
          "model": {
            "datasource": {
              "type": "prometheus",
              "uid": "afcql1n10tnggc"
            },
            "editorMode": "code",
            "expr": "(max by (equipmentno) (last_over_time(avtools_pdu_query_current_utilized_pct{submitter_environment=\"prod\"}[30d])) >= 80) < 90",
            "instant": true,
            "range": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "#PDU Util Warn"
          }
        },
        {
          "refId": "Active",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "#PDU Util Warn",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "Active",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "300s",
      "annotations": {
        "__dashboardUid__": "av_devices_details",
        "__panelId__": "134",
        "description": "- PDU line current 80-90% of capacity (per-device)\n  Fires once per PDU whose latest line-current utilisation is in the 80-90% band (NEC 80% guidance). Mutually exclusive with the critical rule.\n  Action: review load on the affected PDU before it reaches capacity.",
        "summary": "PDU {{ $labels.equipmentno }} line current is in the 80-90% band"
      },
      "labels": {
        "av_alert_type": "operational",
        "severity": "warning",
        "av_alert_family": "operational"
      },
      "isPaused": false,
      "notification_settings": {
        "receiver": "AV Tools",
        "group_by": [
          "alertname",
          "grafana_folder"
        ],
        "group_wait": "1m",
        "group_interval": "168h",
        "repeat_interval": "168h"
      },
      "record": null
    },
    {
      "id": 0,
      "uid": "avpduutilcrit",
      "orgID": 12,
      "folderUID": "beuar1of5bo5cf",
      "ruleGroup": "avtools-pdu-state",
