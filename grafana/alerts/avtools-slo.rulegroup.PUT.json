    {
      "id": 0,
      "uid": "avslotargetdrop",
      "orgID": 12,
      "folderUID": "beuar1of5bo5cf",
      "ruleGroup": "avtools-slo",
      "title": "AV SLO: Targeted Device Count Dropped (Silent Under-Monitoring)",
      "condition": "Active",
      "data": [
        {
          "refId": "#TargetDrop",
          "queryType": "",
          "relativeTimeRange": {
            "from": 86400,
            "to": 0
          },
          "datasourceUid": "afcql1n10tnggc",
          "model": {
            "datasource": {
              "type": "prometheus",
              "uid": "afcql1n10tnggc"
            },
            "editorMode": "code",
            "expr": "sum(avtools_snmp_devices_targeted{submitter_environment=\"prod\"}) < (0.90 * avg_over_time(sum(avtools_snmp_devices_targeted{submitter_environment=\"prod\"})[1d:10m]))",
            "instant": true,
            "range": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "#TargetDrop"
          }
        },
        {
          "refId": "Active",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "#TargetDrop",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "Active",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "10m",
      "annotations": {
        "__dashboardUid__": "av_rooms_dashboard",
        "__panelId__": "900",
        "description": "- Targeted-count drop SLO\n  The absolute targeted device count fell below 90% of its trailing-day average while coverage (a ratio) can still read ~1.0 \u2014 i.e. EAM/LanDB returned a shrunken device set and a chunk of the fleet is silently unmonitored.\n  Action: check the last run-eam / run-landb sync and the EAM/LanDB source data.",
        "summary": "Targeted device count dropped >10% vs the trailing-day baseline (possible silent under-monitoring)"
      },
