{
  "title": "avtools-slo",
  "folderUid": "beuar1of5bo5cf",
  "interval": 300,
  "rules": [
    {
      "id": 0,
      "uid": "avslocoveragewarn",
      "orgID": 12,
      "folderUID": "beuar1of5bo5cf",
      "ruleGroup": "avtools-slo",
      "title": "AV SLO: Collection Coverage Below 99% (Warning)",
      "condition": "Active",
      "data": [
        {
          "refId": "#Coverage",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "afcql1n10tnggc",
          "model": {
            "datasource": {
              "type": "prometheus",
              "uid": "afcql1n10tnggc"
            },
            "editorMode": "code",
            "expr": "sum(avtools_snmp_devices_polled{submitter_environment=\"prod\"}) / sum(avtools_snmp_devices_targeted{submitter_environment=\"prod\"})",
            "instant": true,
            "range": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "#Coverage"
          }
        },
        {
          "refId": "Active",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0.99
                  ],
                  "type": "lt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "#Coverage",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "Active",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "0s",
      "annotations": {
        "__dashboardUid__": "av_rooms_dashboard",
        "__panelId__": "900",
        "description": "- Coverage SLO (warning)\n  polled/targeted dropped below 0.99. Some targeted devices were not polled this cycle.\n  Action: check for over-concurrency / UDP loss (ramp `threads` down) or a collection error.",
        "summary": "SNMP collection coverage {{ $values.C.Value }} is below the 0.99 SLO"
      },
      "labels": {
        "av_alert_type": "slo",
        "severity": "warning",
        "av_alert_family": "slo"
      },
      "isPaused": false,
      "notification_settings": {
        "receiver": "AV Tools",
        "group_by": [
          "alertname",
          "grafana_folder"
        ],
        "group_wait": "30s",
        "group_interval": "168h",
        "repeat_interval": "168h"
      },
      "record": null
    },
