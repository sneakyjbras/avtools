{
  "title": "avtools-pdu-environment",
  "folderUid": "beuar1of5bo5cf",
  "interval": 300,
  "rules": [
    {
      "id": 0,
      "uid": "avpdutempcrit",
      "orgID": 12,
      "folderUID": "beuar1of5bo5cf",
      "ruleGroup": "avtools-pdu-environment",
      "title": "AV Tools: PDU Temperature Critical",
      "condition": "Active",
      "data": [
        {
          "refId": "#Temp Crit",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "afcql1n10tnggc",
          "model": {
            "datasource": {
              "type": "prometheus",
              "uid": "afcql1n10tnggc"
            },
            "editorMode": "code",
            "expr": "avtools_pdu_query_temperature_c{submitter_environment=\"prod\"} > 32",
            "instant": true,
            "range": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "#Temp Crit"
          }
        },
        {
          "refId": "Active",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "#Temp Crit",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "Active",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "300s",
      "annotations": {
        "__dashboardUid__": "av_devices_details",
        "__panelId__": "190",
        "description": "- PDU temperature sensor above 32 C (per device + sensor; ASHRAE allowable ceiling)\n  Sustained high intake/rack temperature risks equipment. Check cooling/airflow at the affected rack.",
        "summary": "PDU {{ $labels.equipmentno }} sensor {{ $labels.sensorindex }} temperature critical (>32C)"
      },
      "labels": {
        "av_alert_type": "environmental",
        "severity": "critical",
        "av_alert_family": "operational"
      },
      "isPaused": false,
      "notification_settings": {
        "receiver": "AV Tools",
        "group_by": [
          "alertname",
          "grafana_folder"
        ],
        "group_wait": "1m",
        "group_interval": "1h",
        "repeat_interval": "6h"
      },
      "record": null
    },
    {
      "id": 0,
      "uid": "avpdutempwarn",
      "orgID": 12,
      "folderUID": "beuar1of5bo5cf",
      "ruleGroup": "avtools-pdu-environment",
      "title": "AV Tools: PDU Temperature Warning",
      "condition": "Active",
      "data": [
        {
          "refId": "#Temp Warn",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "afcql1n10tnggc",
          "model": {
            "datasource": {
              "type": "prometheus",
              "uid": "afcql1n10tnggc"
            },
            "editorMode": "code",
            "expr": "(avtools_pdu_query_temperature_c{submitter_environment=\"prod\"} > 27) <= 32",
            "instant": true,
            "range": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "#Temp Warn"
          }
        },
        {
          "refId": "Active",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "#Temp Warn",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "Active",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "300s",
      "annotations": {
        "__dashboardUid__": "av_devices_details",
        "__panelId__": "190",
        "description": "- PDU temperature sensor 27-32 C (per device + sensor; above ASHRAE recommended 27 C)\n  Early warning of rising rack temperature. Thresholds are ASHRAE-aligned defaults - tune to your facility.",
        "summary": "PDU {{ $labels.equipmentno }} sensor {{ $labels.sensorindex }} temperature warning (>27C)"
      },
      "labels": {
        "av_alert_type": "environmental",
        "severity": "warning",
        "av_alert_family": "operational"
      },
      "isPaused": false,
      "notification_settings": {
        "receiver": "AV Tools",
        "group_by": [
          "alertname",
          "grafana_folder"
        ],
        "group_wait": "1m",
        "group_interval": "1h",
        "repeat_interval": "6h"
      },
      "record": null
    },
    {
      "id": 0,
      "uid": "avpduhumidrange",
      "orgID": 12,
      "folderUID": "beuar1of5bo5cf",
      "ruleGroup": "avtools-pdu-environment",
      "title": "AV Tools: PDU Humidity Out of Range",
      "condition": "Active",
      "data": [
        {
          "refId": "#Humid",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "afcql1n10tnggc",
          "model": {
            "datasource": {
              "type": "prometheus",
              "uid": "afcql1n10tnggc"
            },
            "editorMode": "code",
            "expr": "(avtools_pdu_query_humidity_pct{submitter_environment=\"prod\"} < 20) or (avtools_pdu_query_humidity_pct{submitter_environment=\"prod\"} > 80)",
            "instant": true,
            "range": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "#Humid"
          }
        },
        {
          "refId": "Active",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "#Humid",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "Active",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "300s",
      "annotations": {
        "__dashboardUid__": "av_devices_details",
        "__panelId__": "190",
        "description": "- PDU humidity outside 20-80% (per device + sensor)\n  Low humidity raises static-discharge risk; high humidity raises condensation risk. Bounds are general datacentre defaults - tune to your facility.",
        "summary": "PDU {{ $labels.equipmentno }} sensor {{ $labels.sensorindex }} humidity out of range"
      },
      "labels": {
        "av_alert_type": "environmental",
        "severity": "warning",
        "av_alert_family": "operational"
      },
      "isPaused": false,
      "notification_settings": {
        "receiver": "AV Tools",
        "group_by": [
          "alertname",
          "grafana_folder"
        ],
        "group_wait": "1m",
        "group_interval": "1h",
        "repeat_interval": "6h"
      },
      "record": null
    }
  ]
}
