{
  "title": "avtools-network-state",
  "folderUid": "beuar1of5bo5cf",
  "interval": 300,
  "rules": [
    {
      "id": 0,
      "uid": "avnetpingoffline",
      "orgID": 12,
      "folderUID": "beuar1of5bo5cf",
      "ruleGroup": "avtools-network-state",
      "title": "AV Tools: Devices Offline (Latest Ping State)",
      "condition": "Active",
      "data": [
        {
          "refId": "#Devices Offline",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "afcql1n10tnggc",
          "model": {
            "datasource": {
              "type": "prometheus",
              "uid": "afcql1n10tnggc"
            },
            "editorMode": "code",
            "expr": "(max by (equipmentno) (last_over_time(avtools_ping_check_status{submitter_environment=\"prod\"}[30d])) == 0) + 1",
            "instant": true,
            "range": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "#Devices Offline"
          }
        },
        {
          "refId": "Active",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "#Devices Offline",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "Active",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "300s",
      "annotations": {
        "__dashboardUid__": "av_devices_dashboard",
        "__panelId__": "20",
        "description": "- Devices offline (per-device)\n  Fires once per networked device whose latest known ping state is offline (avtools_ping_check_status == 0).\n  Action: investigate network reachability for the affected equipment.",
        "summary": "Device {{ $labels.equipmentno }} latest ping state is offline"
      },
      "labels": {
        "av_alert_type": "operational",
        "av_alert_family": "operational"
      },
      "isPaused": false,
      "notification_settings": {
        "receiver": "AV Tools",
        "group_by": [
          "alertname",
          "grafana_folder"
        ],
        "group_wait": "1m",
        "group_interval": "168h",
        "repeat_interval": "168h"
      },
      "record": null
    },
    {
      "id": 0,
      "uid": "avnetsnmpdown",
      "orgID": 12,
      "folderUID": "beuar1of5bo5cf",
      "ruleGroup": "avtools-network-state",
      "title": "AV Tools: Online Devices Without SNMP",
      "condition": "Active",
      "data": [
        {
          "refId": "#Online Devices w/o SNMP",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "afcql1n10tnggc",
          "model": {
            "datasource": {
              "type": "prometheus",
              "uid": "afcql1n10tnggc"
            },
            "editorMode": "code",
            "expr": "(max by (equipmentno) (last_over_time(avtools_ping_check_status{submitter_environment=\"prod\"}[30d])) == 1)\nand\n(max by (equipmentno) (last_over_time(avtools_snmp_probe_status{submitter_environment=\"prod\"}[30d])) == 0)",
            "instant": true,
            "range": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "#Online Devices w/o SNMP"
          }
        },
        {
          "refId": "Active",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "#Online Devices w/o SNMP",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "Active",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "10m",
      "annotations": {
        "__dashboardUid__": "av_devices_dashboard",
        "__panelId__": "20",
        "description": "- Online devices without SNMP (per-device)\n  Fires when a device is reachable by ping (ping == 1) but its latest SNMP probe is inactive (snmp == 0) for a sustained period (for: 10m). This is the reachable-but-not-yielding case that ping alone cannot see: a rotated community string, a wedged SNMP agent, a dropped UDP/161 ACL, or a broken MIB all leave ping green while SNMP data freezes.\n  Offline devices are excluded (covered by the Devices Offline alert).\n  Action: check SNMP credentials/community string, ACLs on UDP 161, and the agent on the affected equipment.",
        "summary": "Device {{ $labels.equipmentno }} is online but SNMP is inactive"
      },
      "labels": {
        "av_alert_type": "operational",
        "av_alert_family": "operational",
        "severity": "warning"
      },
      "isPaused": false,
      "notification_settings": {
        "receiver": "AV Tools",
        "group_by": [
          "alertname",
          "grafana_folder"
        ],
        "group_wait": "1m",
        "group_interval": "168h",
        "repeat_interval": "168h"
      },
      "record": null
    }
  ]
}
