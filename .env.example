# Local testing of the sharded SNMP sweep. Copy to .env (gitignored) and fill in:
#
#   set -a && source .env && set +a
#   poetry run avtools --logs snmp-timeseries
#
# This runs ONE shard (index 0 of an 8-way split) against the QA database, so
# you can validate the sharding end-to-end before any container/cluster exists.
# Never commit real secrets — .env is in .gitignore.

# --- required ---
DATABASE_URL=            # QA DBoD URL:   tbag show database_url_qa --hg itdcim/av --plain
MONIT_TENANT=avtools
MONIT_PASSWORD=          # MONIT tenant:  tbag show monit_pwd --hg itdcim/av --plain

# --- MONIT OTLP (defaults shown) ---
MONIT_OTLP_ENDPOINT=monit-otlp.cern.ch:4316
MONIT_OTLP_INSECURE=true

# --- metric labels ---
AVTOOLS_ENVIRONMENT=qa
AVTOOLS_HOSTGROUP=itdcim/av
AVTOOLS_AVAILABILITY_ZONE=cern-geneva-b

# --- sharding: simulate one pod of an 8-way split ---
SHARD_TOTAL=8
JOB_COMPLETION_INDEX=0   # change to 1..7 to test other shards
THREADS=8

# --- keep logs off /var/log for local runs ---
AVTOOLS_LOG_FILE=/tmp/avtools/avtools.jsonl
